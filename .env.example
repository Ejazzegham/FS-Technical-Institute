# --- Firebase (client-side, safe to expose - get from Firebase Console > Project Settings) ---
# Also enable Authentication > Sign-in method > Email/Password, and Firestore Database.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-side only, keep secret) ---
# Needed so the admin panel's Delete button can fully remove a record,
# including the student's Firebase Auth login (not just the Firestore doc) -
# otherwise their email stays "taken" even after you delete them.
# Get these from Firebase Console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file with these 3 values).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Cloudflare R2 (server-side only, keep secret) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Optional: public URL if bucket has a public dev URL or custom domain attached
CLOUDFLARE_R2_PUBLIC_URL=
